				},
				"inputs": [
					{
						"referenceName": "DelimitedText5",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "SnowflakeTable4",
						"type": "DatasetReference"
					}
				]
			}
		],
		"variables": {
			"myFileName": {
				"type": "String",
				"defaultValue": "NYDP_ALTERYX_OUTPUT"
			}
		},
		"annotations": []
	}
}